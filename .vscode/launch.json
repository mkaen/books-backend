{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run books-backend",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/.env",
      "jinja": true
    },
    {
      "name": "Flask: books-backend",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["run", "--debug", "--host", "0.0.0.0", "--port", "5001"],
      "cwd": "${workspaceFolder}",
      "env": {
        "FLASK_APP": "src.main:create_app",
        "FLASK_DEBUG": "1",
        "PYTHONPATH": "${workspaceFolder}"
      },
      "envFile": "${workspaceFolder}/.env",
      "jinja": true
    }
  ]
}
